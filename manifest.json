{
  "manifest_version": 3,
  "name": "Netflix Subtitle Styler",
  "version": "1.0.0",
  "description": "Customize Netflix subtitle font (including fonts installed on your PC), size, color, outline and background.",
  "permissions": ["storage", "fontSettings"],
  "action": {
    "default_title": "Netflix Subtitle Styler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
